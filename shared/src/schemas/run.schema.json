{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "Run",
  "description": "Execution run record",
  "properties": {
    "id": { "type": "string" },
    "roadmapId": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["pending", "executing", "paused", "completed", "failed"]
    },
    "currentPhase": { "type": "number" },
    "currentTask": { "type": "string" },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" },
    "costMetrics": {
      "type": "object",
      "properties": {
        "totalCost": { "type": "number" },
        "tokensUsed": { "type": "number" },
        "modelUsed": { "type": "string" }
      },
      "required": ["totalCost"]
    },
    "artifacts": { "type": "array", "items": { "type": "string" } },
    "failures": { "type": "array", "items": { "type": "object" } },
    "repairs": { "type": "array", "items": { "type": "object" } },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "required": ["id", "roadmapId", "status", "costMetrics", "artifacts", "failures", "repairs", "createdAt", "updatedAt"],
  "additionalProperties": false
}
