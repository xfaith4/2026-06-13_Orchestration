# Backend Configuration
BACKEND_PORT=3007
BACKEND_HOST=localhost
BACKEND_CORS_ORIGIN=http://localhost:5176
NODE_ENV=development

# Frontend Configuration
FRONTEND_PORT=5176
VITE_API_BASE_URL=http://localhost:3007/api

# Database (placeholder for Phase 1+)
# DATABASE_URL=

# Anthropic API — required for real LLM execution
# Get your key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Optional: override the default model (claude-haiku-4-5-20251001 is fast and cheap)
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
