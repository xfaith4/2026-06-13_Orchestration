{
  "name": "@unifiedaitoolbox/frontend",
  "version": "0.1.0",
  "type": "module",
  "description": "UnifiedAIToolbox React Frontend",
  "main": "src/main.tsx",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "typecheck": "tsc --noEmit",
    "test": "echo \"Frontend tests pending for Phase 2\"",
    "clean": "rm -rf dist node_modules .turbo .eslintcache"
  },
  "dependencies": {
    "react": "^18.3.1",
