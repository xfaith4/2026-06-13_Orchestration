# Logs & Runtime
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*
debug.log
orchestrator.debug.log

# Runtime State (auto-generated per orchestration run)
# NOTE: These are generated by the orchestrator and should NOT be committed
# They contain run-specific state that will differ across executions
.orchestration/state.json
.orchestration/orchestrator.log
.orchestration/capsules/*.txt
.orchestration/capsules/*.json

# Past Run Artifacts
PastAttemptedRuns/        # Historical orchestration run artifacts, not part of current codebase

# Temporary files
.tmp/
tmp/
temp/
*.tmp

# Compiled outputs
*.o
*.a
*.lib
*.so
*.dylib
*.dll

# Test coverage
coverage/
.nyc_output/
htmlcov/

# Package manager caches
.npm/
.yarn/cache/
.yarn/install-state.gz

# Misc
.turbo/
.cache/
.eslintcache
.prettierignore
tsbuildinfo

# Keep these even though they're in .orchestration/
# (Structure needed for orchestrator to function)
!.orchestration/
!.orchestration/capsules/
!.orchestration/.gitkeep
