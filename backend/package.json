{
  "name": "@unifiedaitoolbox/backend",
  "version": "0.1.0",
  "description": "UnifiedAIToolbox backend API server",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "node ../scripts/ensure-port-free.mjs backend && tsx watch src/server.ts",
    "build": "tsc",
    "start": "node ../scripts/ensure-port-free.mjs backend && node dist/server.js",
    "test": "vitest",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "@unifiedaitoolbox/shared": "*",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "uuid": "^14.0.0",
    "vite": "8.0.16"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.17",
    "@types/node": "^20.4.5",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^6.2.1",
    "@typescript-eslint/parser": "^6.2.1",
    "eslint": "^8.46.0",
    "prettier": "^3.0.1",
    "supertest": "^7.2.2",
    "tsx": "^3.12.7",
    "typescript": "^5.1.6",
    "vitest": "^4.1.8"
  }
}
