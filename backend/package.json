{
  "name": "@unifiedaitoolbox/backend",
  "version": "0.1.0",
  "type": "module",
  "description": "UnifiedAIToolbox Express Backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "node --loader ts-node/esm src/server.ts",
    "build": "tsc --noEmit && tsc",
    "start": "node dist/server.js",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "test": "echo \"Backend tests pending for Phase 2\"",
    "clean": "rm -rf dist node_modules .turbo .eslintcache"
  },
  "dependencies": {
    "express": "^4.19.2",
    "@unifiedaitoolbox/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.0",
    "typescript": "^5.5.0",
    "ts-node": "^10.9.2"
  }
}
